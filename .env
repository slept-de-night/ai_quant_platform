# OpenAI
OPENAI_API_KEY=

# Model deployment policy
MODEL_FAST=gpt-5.6-luna
MODEL_BALANCED=gpt-5.6-terra
MODEL_FRONTIER=gpt-5.6-sol
ENABLE_PRO_MODE=false

# Model-cost inputs used by the local evaluation/router ledger.
# USD per 1M tokens. These defaults are a project snapshot; verify current pricing before production.
MODEL_FAST_INPUT_USD_PER_M=0.10
MODEL_FAST_OUTPUT_USD_PER_M=0.60
MODEL_BALANCED_INPUT_USD_PER_M=1.00
MODEL_BALANCED_OUTPUT_USD_PER_M=6.00
MODEL_FRONTIER_INPUT_USD_PER_M=2.50
MODEL_FRONTIER_OUTPUT_USD_PER_M=15.00

# Bounded multi-agent orchestration
AGENT_MAX_DEPTH=2
AGENT_MAX_CHILDREN=4
AGENT_MAX_TASKS_PER_RUN=24
AGENT_TOKEN_BUDGET=180000
AGENT_MAX_FRONTIER_TASKS=6
AGENT_USD_BUDGET_PER_RUN=10

# Durable local task runtime
RUNTIME_CONCURRENCY=4
RUNTIME_LEASE_SECONDS=120
RUNTIME_MAX_ATTEMPTS=3
RUNTIME_RETRY_BASE_SECONDS=2
RUNTIME_MAX_RETRY_DELAY_SECONDS=300

# Empirical routing recommendations. Recommendations never auto-activate.
ROUTER_LEARNING_MIN_SAMPLES=8
ROUTER_LEARNING_MIN_QUALITY=0.72
ROUTER_LEARNING_MIN_SUCCESS=0.90

# Durable agent memory / audit journal
AGENT_MEMORY_DIR=agent_memory
AGENT_MEMORY_MAX_PROMPT_NOTES=12
AGENT_MEMORY_DEFAULT_EXPIRY_DAYS=90

# Research services
ENABLE_WEB_RESEARCH=true
SEC_USER_AGENT=
FRED_API_KEY=
DOSSIER_MAX_AGE_HOURS=24
REQUIRE_FRESH_DOSSIER=true
EXTRA_PRIMARY_DOMAINS=
EXTRA_TRUSTED_DOMAINS=

# Alpaca PAPER only
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
USE_ALPACA_DATA=false

# Validation
DB_PATH=ai_quant.sqlite3
ALPHA_CANDIDATES=8
WF_TRAIN_DAYS=504
WF_TEST_DAYS=126
WF_STEP_DAYS=126
MIN_WF_FOLDS=2
MIN_VALIDATION_SHARPE=0.50
MAX_VALIDATION_DRAWDOWN=0.25
MIN_ROBUST_SCORE=0.20

# Risk
STARTING_EQUITY=100000
MAX_POSITION_PCT=0.08
MAX_GROSS_EXPOSURE_PCT=0.60
MIN_CASH_RESERVE_PCT=0.10
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_ORDERS_PER_DAY=8
MIN_ORDER_NOTIONAL=50

# Backtest assumptions
SLIPPAGE_BPS=5
COMMISSION_BPS=0
